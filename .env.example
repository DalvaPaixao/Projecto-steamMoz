# Copia este ficheiro para ".env" (mesma pasta do docker-compose.yml e do app.py)
# e ajusta os valores antes de correr "docker compose up -d" ou "python app.py".
# O ficheiro ".env" NÃO vai para o Git (já está no .gitignore): é lá que ficam
# as senhas reais. Este ".env.example" só tem valores de exemplo.

# Password do utilizador root do MySQL (o container cria-o sozinho).
MYSQL_ROOT_PASSWORD=troca-esta-password

# Nome da base de dados (criada automaticamente pelo backend).
DB_NAME=stemmoz_rh

# Endereço público pelo qual o navegador vai contactar o backend.
# Usa o IP ou domínio do teu servidor Ubuntu, porta 5000.
VITE_API_URL=http://SEU_IP_OU_DOMINIO:5000

# --- Login do sistema ---
# Utilizador administrador, criado automaticamente ao arrancar o backend.
# Para mudar a senha mais tarde, altera ADMIN_PASSWORD aqui e reinicia o backend.
ADMIN_USER=Nome do Administrador
ADMIN_PASSWORD=troca-esta-senha

# Chave que assina as sessões (tokens). Gera uma longa e aleatória, por exemplo
# com:  python -c "import secrets; print(secrets.token_hex(32))"
# Se ficar vazia e correres o backend sem Docker, o app.py gera uma e grava-a
# neste ficheiro. Com Docker, preenche-a tu.
SECRET_KEY=