# Copia este ficheiro para ".env" (mesma pasta do docker-compose.yml) e
# ajusta os valores antes de correr "docker compose up -d".

# Password do utilizador root do MySQL (o container cria-o sozinho).
MYSQL_ROOT_PASSWORD=troca-esta-password

# Nome da base de dados (criada automaticamente pelo backend).
DB_NAME=stemmoz_rh

# Endereço público pelo qual o navegador vai contactar o backend.
# Usa o IP ou domínio do teu servidor Ubuntu, porta 5000.
VITE_API_URL=http://SEU_IP_OU_DOMINIO:5000
